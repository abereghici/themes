---
output: themes/bereghici.yml
---
# Bereghici Dark and Light for lazygit. Generated from abereghici/themes; do not edit.
# Merge it after your own config: LG_CONFIG_FILE="<your config.yml>,<this file>"
gui:
  colorScheme: auto
  # One color for every author instead of a hash of each name, which lands outside the palette.
  # authorColors can't follow the appearance, so it names the terminal's blue, which does
  authorColors:
    "*": blue
  darkTheme:
{{#dark}}
{{> theme}}
{{/dark}}
  lightTheme:
{{#light}}
{{> theme}}
{{/light}}
