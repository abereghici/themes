# Bereghici Terminal for zsh-syntax-highlighting and zsh-autosuggestions. Generated from abereghici/themes; do not edit.
# In the terminal's ANSI colors: with a Bereghici terminal theme it switches with it between
# Dark and Light.
# Source it before zsh-syntax-highlighting (its defaults keep the styles set here).
typeset -gA ZSH_HIGHLIGHT_STYLES

ZSH_HIGHLIGHT_STYLES[default]='fg=15'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=1'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=5'
ZSH_HIGHLIGHT_STYLES[alias]='fg=4'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg=4'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg=4'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=4'
ZSH_HIGHLIGHT_STYLES[function]='fg=4'
ZSH_HIGHLIGHT_STYLES[command]='fg=4'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=5'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=4'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=4,underline'
ZSH_HIGHLIGHT_STYLES[arg0]='fg=4'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=8'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=8'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=8'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=8'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=6'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=6'
ZSH_HIGHLIGHT_STYLES[path]='fg=15,underline'
ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg=8,underline'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=15,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=5'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=5'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=3'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=3'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=3'
ZSH_HIGHLIGHT_STYLES[rc-quote]='fg=3'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=6'
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]='fg=6'
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg=6'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=5'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimiter]='fg=8'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg=8'
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]='fg=8'
ZSH_HIGHLIGHT_STYLES[assign]='fg=15'
ZSH_HIGHLIGHT_STYLES[comment]='fg=8'

# zsh-autosuggestions: the suggested rest of the line
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
