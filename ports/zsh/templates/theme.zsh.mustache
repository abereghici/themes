---
output: themes/{{id}}.zsh
flavors: [dark, light, terminal]
---
# {{name}} for zsh-syntax-highlighting and zsh-autosuggestions. Generated from abereghici/themes; do not edit.
{{#isTerminal}}# In the terminal's ANSI colors: with a Bereghici terminal theme it switches with it between
# Dark and Light.
{{/isTerminal}}# Source it before zsh-syntax-highlighting (its defaults keep the styles set here).
typeset -gA ZSH_HIGHLIGHT_STYLES

ZSH_HIGHLIGHT_STYLES[default]='fg={{colors.text.ref}}'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{colors.red.ref}}'
