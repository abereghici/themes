  "tokenColors": [
    {
      "name": "Plain text",
      "settings": { "foreground": "{{colors.text.hex}}" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{colors.textSubtlest.hex}}", "fontStyle": "italic" }
    },
    {
      "name": "Documentation tags in comments",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation entity.name.type",
        "comment.block.documentation variable",
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": { "foreground": "{{colors.textSubtle.hex}}", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string", "string.template", "string.quoted"],
      "settings": { "foreground": "{{colors.yellow.hex}}" }
    },
    {
      "name": "Escapes and placeholders",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "constant.other.placeholder",
        "string.regexp constant.character.escape"
      ],
      "settings": { "foreground": "{{colors.cyan.hex}}" }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.embedded punctuation.section.embedded"
      ],
      "settings": { "foreground": "{{colors.magenta.hex}}" }
    },
    {
      "name": "Interpolated code",
      "scope": ["meta.template.expression", "meta.embedded.line"],
      "settings": { "foreground": "{{colors.text.hex}}" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "source.regexp"],
      "settings": { "foreground": "{{colors.yellowBright.hex}}" }
    },
    {
      "name": "Regular expression operators",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": { "foreground": "{{colors.yellow.hex}}" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "keyword.other.unit"],
      "settings": { "foreground": "{{colors.cyan.hex}}" }
    },
    {
      "name": "Constants and booleans",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.character"
      ],
      "settings": { "foreground": "{{colors.cyan.hex}}" }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": { "foreground": "{{colors.magenta.hex}}" }
    },
    {
      "name": "Built-in variables",
      "scope": ["variable.language", "support.variable.self", "variable.parameter.function.language.special.self"],
      "settings": { "foreground": "{{colors.magenta.hex}}", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value"],
      "settings": { "foreground": "{{colors.textSubtle.hex}}" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
