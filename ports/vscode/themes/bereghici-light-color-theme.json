    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#a84837" }
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#c3720f", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#686a64", "italic": true },
    "string": "#c3720f",
    "regexp": "#925613",
    "number": "#007a80",
    "keyword": "#8b537f",
    "operator": "#535750",
    "namespace": "#007a80",
    "type": "#007a80",
    "class": "#007a80",
    "interface": "#007a80",
    "struct": "#007a80",
    "enum": "#007a80",
    "enumMember": "#007a80",
    "typeParameter": "#007a80",
    "function": "#1f7c44",
    "method": "#1f7c44",
    "macro": "#1f7c44",
    "decorator": "#1f7c44",
    "parameter": "#6b3e62",
    "variable": "#2e3229",
    "variable.defaultLibrary": "#007a80",
    "property": "#2f6da4",
    "event": "#2f6da4",
    "label": "#535750",
    "selfKeyword": { "foreground": "#8b537f", "italic": true },
    "builtinConstant": "#007a80",
