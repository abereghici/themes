      "settings": { "foreground": "#d37e6d" }
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#f5ac69", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#a2a69d", "italic": true },
    "string": "#f5ac69",
    "regexp": "#fabc86",
    "number": "#5daeb2",
    "keyword": "#bc8db1",
    "operator": "#bbbeb6",
    "namespace": "#5daeb2",
    "type": "#5daeb2",
    "class": "#5daeb2",
    "interface": "#5daeb2",
    "struct": "#5daeb2",
    "enum": "#5daeb2",
    "enumMember": "#5daeb2",
    "typeParameter": "#5daeb2",
    "function": "#79b589",
    "method": "#79b589",
    "macro": "#79b589",
    "decorator": "#79b589",
    "parameter": "#d4acca",
    "variable": "#eeefe9",
    "variable.defaultLibrary": { "foreground": "#bc8db1", "italic": true },
    "property": "#74a3d1",
    "event": "#74a3d1",
    "label": "#bbbeb6",
    "selfKeyword": { "foreground": "#bc8db1", "italic": true },
    "builtinConstant": "#5daeb2",
    "*.deprecated": { "strikethrough": true }
  }
}
