---
output: themes/{{id}}.yml
flavors: [dark, light, terminal]
---
# {{name}} for lazydocker. Generated from abereghici/themes; do not edit.
{{#isTerminal}}# In the terminal's ANSI colors: with a Bereghici terminal theme it switches with it between
# Dark and Light.
{{/isTerminal}}# Paste it into lazydocker's config.yml.
gui:
  theme:
    activeBorderColor:
      - {{#isTerminal}}{{colors.accent.name}}{{/isTerminal}}{{^isTerminal}}"{{colors.accent.hex}}"{{/isTerminal}}
      - bold
    # lazydocker knows only the 8 basic names (no bright-black), so the terminal flavor keeps white
    inactiveBorderColor:
      - {{#isTerminal}}{{colors.textSubtle.name}}{{/isTerminal}}{{^isTerminal}}"{{colors.border.hex}}"{{/isTerminal}}
    # The background is the selected row's only cue. In ANSI every selection-like role is colour 0,
    # which barely differs from the terminal background, so the terminal flavor reverses the row.
    selectedLineBgColor:
      - {{#isTerminal}}reverse{{/isTerminal}}{{^isTerminal}}"{{colors.selection.hex}}"{{/isTerminal}}
    optionsTextColor:
      - {{#isTerminal}}{{colors.blue.name}}{{/isTerminal}}{{^isTerminal}}"{{colors.blue.hex}}"{{/isTerminal}}
